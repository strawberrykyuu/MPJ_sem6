import java.util.Scanner;

class Student {
    int rollNo;
    String name;
    double math, science;

    Student(int r, String n, double math, double science) {
        rollNo = r;
        name = n;
        this.math = math;
        this.science = science;
    }

    void displayStudent() {
        double average = (math + science) / 2;
        System.out.println("Roll No: " + rollNo);
        System.out.println("Name: " + name);
        System.out.println("Average of Math and Science: " + average);
    }

    static double calculateSubjectAverage(Student[] students) {
        double totalMath = 0, totalScience = 0;
        for (Student s : students) {
            totalMath += s.math;
            totalScience += s.science;
        }
        double avgMath = totalMath / students.length;
        double avgScience = totalScience / students.length;
        System.out.println("Average of Math: " + avgMath);
        System.out.println("Average of Science: " + avgScience);
        return (avgMath + avgScience) / 2;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Student[] students = new Student[10];

        for (int i = 0; i < 10; i++) {
            System.out.print("Enter roll number for student " + (i + 1) + ": ");
            int rollNo = scanner.nextInt();
            scanner.nextLine();
            System.out.print("Enter name for student " + (i + 1) + ": ");
            String name = scanner.nextLine();
            System.out.print("Enter Math marks for student " + (i + 1) + ": ");
            double math = scanner.nextDouble();
            System.out.print("Enter Science marks for student " + (i + 1) + ": ");
            double science = scanner.nextDouble();
            students[i] = new Student(rollNo, name, math, science);
        }

        for (Student s : students) {
            s.displayStudent();
        }

        double overallSubjectAverage = Student.calculateSubjectAverage(students);
        System.out.println("Overall average of Math and Science: " + overallSubjectAverage);

        scanner.close();
    }
}
